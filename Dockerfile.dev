FROM node:20-alpine

RUN apk add --no-cache openssl

WORKDIR /app

# Install dependencies
COPY package*.json .npmrc ./
RUN npm ci

# Copy source
COPY . .

# Generate Prisma client (needs schema.prisma, copied above)
RUN npx prisma generate

# Build frontend (if needed during dev)
# RUN npm run build

# Expose port
EXPOSE 3000

# Start dev server
CMD ["npm", "run", "dev"]
