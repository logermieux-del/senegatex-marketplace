// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model
model User {
  id            String     @id @default(cuid())
  email         String     @unique
  phone         String?    @unique
  name          String
  avatar        String?    // Cloudinary URL
  bio           String?
  role          UserRole   @default("USER") // USER, SELLER, ADMIN
  emailVerified DateTime?
  password      String     // bcrypt hashed

  // Relations
  listings      Listing[]
  sentMessages  Message[]  @relation("sentMessages")
  receivedMessages Message[] @relation("receivedMessages")
  receivedReviews Review[]  @relation("receivedReviews")
  givenReviews   Review[]   @relation("givenReviews")
  soldTransactions Transaction[] @relation("seller")
  boughtTransactions Transaction[] @relation("buyer")
  reports       Report[]
  moderatorActions ModeratorAction[]

  // Metadata
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  isActive      Boolean    @default(true)
  isSuspended   Boolean    @default(false)
  suspendedUntil DateTime?

  @@index([email])
  @@index([phone])
  @@index([isActive])
}

enum UserRole {
  USER
  SELLER
  ADMIN
}

// Listing model (Product/Service listing)
model Listing {
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  title         String
  description   String     @db.Text
  category      String     // e.g., "electronics", "furniture", "vehicles"
  price         Int        // in XOF (cents)
  currency      String     @default("XOF")
  status        ListingStatus @default("ACTIVE") // ACTIVE, SOLD, DELETED

  // Location (Senegal specific)
  city          String     // Dakar, Thiès, etc.
  region        String?    // Optional: region name
  latitude      Float?     // GPS coordinates
  longitude     Float?

  // Media
  photos        String[]   // Cloudinary URLs
  thumbnail     String?    // Main photo

  // Metadata
  viewCount     Int        @default(0)
  isFeatured    Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  expiresAt     DateTime?  // Auto-archive after 90 days

  // Relations
  messages      Message[]
  transactions  Transaction[]
  reports       Report[]

  @@index([userId])
  @@index([status])
  @@index([city])
  @@index([category])
  @@index([createdAt])
  @@fulltext([title, description]) // For Meilisearch
}

enum ListingStatus {
  ACTIVE
  SOLD
  DELETED
}

// Private messages between users
model Message {
  id            String     @id @default(cuid())
  fromUserId    String
  from          User       @relation("sentMessages", fields: [fromUserId], references: [id], onDelete: Cascade)

  toUserId      String
  to            User       @relation("receivedMessages", fields: [toUserId], references: [id], onDelete: Cascade)

  listingId     String?    // Linked to listing (optional)
  listing       Listing?   @relation(fields: [listingId], references: [id], onDelete: SetNull)

  body          String     @db.Text
  isRead        Boolean    @default(false)

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([fromUserId])
  @@index([toUserId])
  @@index([listingId])
  @@index([createdAt])
}

// Transaction (Payment record)
model Transaction {
  id            String     @id @default(cuid())
  listingId     String
  listing       Listing    @relation(fields: [listingId], references: [id], onDelete: Cascade)

  sellerId      String
  seller        User       @relation("seller", fields: [sellerId], references: [id], onDelete: Cascade)

  buyerId       String
  buyer         User       @relation("buyer", fields: [buyerId], references: [id], onDelete: Cascade)

  amount        Int        // in XOF (cents)
  currency      String     @default("XOF")

  paymentMethod String     // "stripe", "wave", "orange_money"
  paymentStatus PaymentStatus @default("PENDING")

  stripePaymentId String?   // Stripe payment intent ID
  waveTransactionId String? // Wave transaction ID

  notes         String?    @db.Text

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  completedAt   DateTime?

  @@index([sellerId])
  @@index([buyerId])
  @@index([listingId])
  @@index([paymentStatus])
  @@index([createdAt])
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

// Review/Rating
model Review {
  id            String     @id @default(cuid())
  fromUserId    String
  from          User       @relation("givenReviews", fields: [fromUserId], references: [id], onDelete: Cascade)

  toUserId      String
  to            User       @relation("receivedReviews", fields: [toUserId], references: [id], onDelete: Cascade)

  rating        Int        // 1-5 stars
  comment       String?    @db.Text

  transactionId String?    // Optional: link to transaction

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([fromUserId])
  @@index([toUserId])
  @@unique([fromUserId, toUserId]) // One review per user pair
}

// Report/Flag content
model Report {
  id            String     @id @default(cuid())
  listingId     String
  listing       Listing    @relation(fields: [listingId], references: [id], onDelete: Cascade)

  reportedBy    String?    // User ID who reported (optional for anonymous)

  reason        String     // "inappropriate", "fraud", "duplicate", "contact_info", "offensive"
  description   String     @db.Text

  status        ReportStatus @default("PENDING")
  reviewedBy    String?    // Admin ID

  adminNotes    String?    @db.Text

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([listingId])
  @@index([status])
  @@index([createdAt])
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
  ESCALATED
}

// Moderator/Admin actions
model ModeratorAction {
  id            String     @id @default(cuid())
  userId        String
  moderator     User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  action        String     // "suspend", "warn", "unlist", "ban"
  reason        String     @db.Text

  targetUserId  String?    // User affected
  targetListingId String?  // Listing affected

  duration      Int?       // Days (for suspend)

  createdAt     DateTime   @default(now())

  @@index([userId])
  @@index([createdAt])
}
