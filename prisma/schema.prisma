generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model
model User {
  id            String     @id @default(cuid())
  email         String     @unique
  phone         String?    @unique
  name          String
  avatar        String?
  bio           String?
  role          String     @default("USER") // USER, SELLER, ADMIN, TRANSPORTER
  emailVerified DateTime?
  password      String

  // Geographic info
  region        String?    // Dakar, Thiès, Kaolack, etc.
  arrondissement String?   // Plateau, Medina, Parcelles, etc.
  pointRetrait  String?    // Preferred pickup address

  listings      Listing[]
  sentMessages  Message[]  @relation("sentMessages")
  receivedMessages Message[] @relation("receivedMessages")
  receivedReviews Review[]  @relation("receivedReviews")
  givenReviews   Review[]   @relation("givenReviews")
  soldTransactions Transaction[] @relation("seller")
  boughtTransactions Transaction[] @relation("buyer")
  moderatorActions ModeratorAction[]
  notifications Notification[]

  // Transporter data
  transporteur  Transporteur?
  disputesSignaled Dispute[] @relation("signalePar")
  remboursementsAssurance RemboursementAssurance[] @relation("assuranceBeneficiaire")

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  isActive      Boolean    @default(true)
  isSuspended   Boolean    @default(false)
  suspendedUntil DateTime?

  @@index([email])
  @@index([phone])
  @@index([isActive])
  @@index([region])
}

// Listing model
model Listing {
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  title         String
  description   String
  category      String
  price         BigInt // stored as XOF * 100; real estate prices exceed INT4 range
  currency      String     @default("XOF")
  status        String     @default("ACTIVE") // ACTIVE, SOLD, DELETED

  city          String
  region        String?
  latitude      Float?
  longitude     Float?

  // Real estate only (category = "immobilier")
  transactionType String?  // LOCATION, ACHAT, VENTE
  propertyType    String?  // BATI, NON_BATI
  surfaceM2       Float?

  photos        String? // JSON array as string
  thumbnail     String?

  viewCount     Int        @default(0)
  isFeatured    Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  expiresAt     DateTime?

  messages      Message[]
  transactions  Transaction[]
  reports       Report[]

  @@index([userId])
  @@index([status])
  @@index([city])
  @@index([category])
  @@index([createdAt])
}

// Private messages
model Message {
  id            String     @id @default(cuid())
  fromUserId    String
  from          User       @relation("sentMessages", fields: [fromUserId], references: [id], onDelete: Cascade)

  toUserId      String
  to            User       @relation("receivedMessages", fields: [toUserId], references: [id], onDelete: Cascade)

  listingId     String?
  listing       Listing?   @relation(fields: [listingId], references: [id], onDelete: SetNull)

  body          String
  isRead        Boolean    @default(false)

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([fromUserId])
  @@index([toUserId])
  @@index([listingId])
  @@index([createdAt])
}

// Transaction (Payment record)
model Transaction {
  id            String     @id @default(cuid())
  listingId     String
  listing       Listing    @relation(fields: [listingId], references: [id], onDelete: Cascade)

  sellerId      String
  seller        User       @relation("seller", fields: [sellerId], references: [id], onDelete: Cascade)

  buyerId       String
  buyer         User       @relation("buyer", fields: [buyerId], references: [id], onDelete: Cascade)

  amount        Int
  currency      String     @default("XOF")

  paymentMethod String
  paymentStatus String     @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED, REFUNDED

  stripePaymentId String?
  waveTransactionId String?

  notes         String?

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  completedAt   DateTime?

  @@index([sellerId])
  @@index([buyerId])
  @@index([listingId])
  @@index([paymentStatus])
  @@index([createdAt])
}

// Review/Rating
model Review {
  id            String     @id @default(cuid())
  fromUserId    String
  from          User       @relation("givenReviews", fields: [fromUserId], references: [id], onDelete: Cascade)

  toUserId      String
  to            User       @relation("receivedReviews", fields: [toUserId], references: [id], onDelete: Cascade)

  rating        Int
  comment       String?

  transactionId String?

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([fromUserId])
  @@index([toUserId])
  @@unique([fromUserId, toUserId])
}

// Report/Flag content
model Report {
  id            String     @id @default(cuid())
  listingId     String
  listing       Listing    @relation(fields: [listingId], references: [id], onDelete: Cascade)

  reportedBy    String?

  reason        String
  description   String

  status        String     @default("PENDING") // PENDING, RESOLVED, DISMISSED, ESCALATED
  reviewedBy    String?

  adminNotes    String?

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([listingId])
  @@index([status])
  @@index([createdAt])
}

// Moderator/Admin actions
model ModeratorAction {
  id            String     @id @default(cuid())
  userId        String
  moderator     User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  action        String
  reason        String

  targetUserId  String?
  targetListingId String?

  duration      Int?

  createdAt     DateTime   @default(now())

  @@index([userId])
  @@index([createdAt])
}

// ============ TRANSPORTEUR ECOSYSTEM ============

// Transporteur (Driver/Courier)
model Transporteur {
  id                    String     @id @default(cuid())
  userId                String     @unique
  user                  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  typeVehicule          String     // "moto", "voiture", "3roues", "camionnette"
  plaqueImmatriculation String     @unique

  // Coverage & Pricing
  regionsCouvertes      String     // JSON array: ["Dakar", "Thiès", ...]
  tarifParZone          String     // JSON: {Dakar: 2500, Thiès: 4000, ...}
  capaciteVolume        String     // "petit", "moyen", "gros"

  // Verification & Status
  statut                String     @default("PENDING") // PENDING, VERIFIED, ACTIVE, SUSPENDED, INACTIVE
  documentsVerification String?    // JSON: {cin, photoVehicule, certificatCirculation, dateVerification}
  dateVerification      DateTime?

  // Metrics
  notianceGlobale       Float      @default(0.0) // 0-5
  nombreLivraisons      Int        @default(0)
  tauxDisputes          Float      @default(0.0) // 0-100 percent
  lastActivityAt        DateTime?

  // Terms acceptance (simple digital acknowledgement, no e-signature provider)
  conditionsAccepteesAt DateTime?
  conditionsVersion     String?

  livraisons            Livraison[]
  paiements             PaiementTransporteur[]

  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  @@index([userId])
  @@index([statut])
  @@index([regionsCouvertes])
}

// Livraison (Delivery/Order)
model Livraison {
  id                    String     @id @default(cuid())

  // Transaction reference
  transactionId         String?    // FK to Transaction (future link)

  transporteurId        String
  transporteur          Transporteur @relation(fields: [transporteurId], references: [id], onDelete: Cascade)

  // Addresses
  adresseDepart         String     // JSON: {region, arrondissement, rue, lat, lng}
  adresseArrivee        String     // JSON: {region, arrondissement, rue, lat, lng}

  // Status & Tracking
  statut                String     @default("PENDING") // PENDING, ACCEPTED, PICKED_UP, IN_TRANSIT, DELIVERED, FAILED
  locationActuelle      String?    // JSON: {lat, lng, timestamp}

  // Pricing
  tarifNegocie          Int        // XOF
  commissionYombal      Int        // XOF (5-10% of tarif)
  assuranceMontant      Int        @default(0) // XOF, surcharge funding the insurance pool

  // Timeline
  datePrise             DateTime?
  dateEstimeeArrivee    DateTime?
  dateArriveeReelle     DateTime?

  // Proof & Documents
  photoPreuve           String?    // URL to delivery photo

  // Rating (après livraison)
  ratingAcheteur        String?    // JSON: {punctualite, etatProduit, communication, professionalisme, commentaire}

  // Incident tracking
  incident              Boolean    @default(false)

  disputes              Dispute[]
  paiement              PaiementTransporteur?
  remboursementsAssurance RemboursementAssurance[]

  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  @@index([transporteurId])
  @@index([statut])
  @@index([createdAt])
}

// Dispute (Claim/Incident resolution)
model Dispute {
  id                    String     @id @default(cuid())
  livraisonId           String
  livraison             Livraison  @relation(fields: [livraisonId], references: [id], onDelete: Cascade)

  signaleParUserId      String
  signalePar            User       @relation("signalePar", fields: [signaleParUserId], references: [id], onDelete: Cascade)

  raison                String     // "produit_casse", "non_recu", "retard", "autre"
  description           String
  preuves               String?    // JSON: {photos: [...], notes: "..."}

  statut                String     @default("OPEN") // OPEN, IN_REVIEW, RESOLVED, ESCALATED
  resolution            String?    // JSON: {type: "remboursement|compensation", montant, notes}

  reviewedByAdmin       String?
  dateResolution        DateTime?

  remboursement         RemboursementAssurance?

  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  @@index([livraisonId])
  @@index([statut])
  @@index([createdAt])
}

// Remboursement Assurance (paid out of the pooled insurance surcharge when
// a dispute is validated — MVP: manual reconciliation, same pattern as
// PaiementTransporteur, since no automated refund API is realistically
// available to a solo operator).
model RemboursementAssurance {
  id                    String     @id @default(cuid())

  disputeId             String     @unique
  dispute               Dispute    @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  livraisonId           String
  livraison             Livraison  @relation(fields: [livraisonId], references: [id], onDelete: Cascade)

  beneficiaireUserId    String
  beneficiaire          User       @relation("assuranceBeneficiaire", fields: [beneficiaireUserId], references: [id], onDelete: Cascade)

  montant               Int        // XOF
  statut                String     @default("PENDING") // PENDING, PAID

  methode               String?    // "wave", "orange_money", "cash", "virement"
  reference             String?
  paidByAdminId         String?
  paidAt                DateTime?

  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  @@index([statut])
  @@index([createdAt])
}

// Paiement Transporteur (payout tracking — MVP: manual reconciliation, no automated payout API)
model PaiementTransporteur {
  id                    String     @id @default(cuid())

  livraisonId           String     @unique
  livraison             Livraison  @relation(fields: [livraisonId], references: [id], onDelete: Cascade)

  transporteurId        String
  transporteur          Transporteur @relation(fields: [transporteurId], references: [id], onDelete: Cascade)

  montant               Int        // XOF, = tarifNegocie - commissionYombal
  statut                String     @default("PENDING") // PENDING, PAID, FAILED

  methode               String?    // "wave", "orange_money", "cash", "virement"
  reference             String?    // Manual transaction reference (Wave/OM confirmation code)
  paidByAdminId         String?
  paidAt                DateTime?

  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  @@index([transporteurId])
  @@index([statut])
  @@index([createdAt])
}

// Notifications
model Notification {
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  type          String     // NEW_MESSAGE, LISTING_SOLD, PAYMENT_RECEIVED, etc.
  title         String
  message       String     @db.Text

  relatedUserId String?    // User involved (sender, buyer, etc.)
  relatedListingId String? // Related listing
  relatedTransactionId String? // Related transaction

  actionUrl     String?    // URL to action (e.g., /dashboard/messages)
  isRead        Boolean    @default(false)

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}
